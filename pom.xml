<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jahia.modules</groupId>
        <artifactId>jahia-modules</artifactId>
        <version>8.2.0.0</version>
        <relativePath/>
    </parent>

    <groupId>org.jahia.community.modules</groupId>
    <artifactId>jcustomer-sfdc-connector</artifactId>
    <version>2.6.2</version>
    <packaging>bundle</packaging>

    <name>jCustomer - Salesforce Connector</name>
    <description>
        Generic connector that syncs Salesforce Contact and Account data into Apache Unomi (jCustomer)
        profile properties. Supports JWT Bearer auth, configurable field mapping via JCR,
        scheduled batch sync and immediate sync on login events.
    </description>
    <url>https://github.com/Jahia/jcustomer-sfdc-connector</url>

    <organization>
        <name>Jahia Solutions Group SA</name>
        <url>https://www.jahia.com</url>
    </organization>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Jahia/jcustomer-sfdc-connector.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/jcustomer-sfdc-connector.git</developerConnection>
        <url>https://github.com/Jahia/jcustomer-sfdc-connector</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Jahia/jcustomer-sfdc-connector/issues</url>
    </issueManagement>

    <properties>
        <jahia.plugin.version>6.9</jahia.plugin.version>
        <yarn.arguments>build:production</yarn.arguments>
    </properties>

    <dependencies>
        <!-- jExperience: ContextServerService for jCustomer access -->
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>jexperience</artifactId>
            <version>3.8.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Unomi API for profile types -->
        <dependency>
            <groupId>org.apache.unomi</groupId>
            <artifactId>unomi-api</artifactId>
            <version>3.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases><enabled>true</enabled><updatePolicy>never</updatePolicy></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <_dsannotations>org.jahia.community.modules.jcustomer.sfdc.*</_dsannotations>
                        <Jahia-Static-Resources>/javascript</Jahia-Static-Resources>
                        <Import-Package>
                            org.jahia.modules.jexperience.admin,
                            org.apache.unomi.api,
                            org.jahia.services.content,
                            org.jahia.services.render,
                            org.jahia.services.usermanager,
                            org.jahia.bin,
                            org.jahia.settings,
                            org.jahia.osgi,
                            org.osgi.service.event,
                            java.net.http,
                            java.security,
                            java.security.spec,
                            javax.jcr,
                            org.json,
                            org.slf4j,
                            *
                        </Import-Package>
                    </instructions>
                </configuration>
            </plugin>

            <!-- Frontend build: Webpack / Module Federation -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.6</version>
                <executions>
                    <execution>
                        <id>install-node-and-yarn</id>
                        <phase>generate-resources</phase>
                        <goals><goal>install-node-and-yarn</goal></goals>
                        <configuration>
                            <nodeVersion>v20.18.0</nodeVersion>
                            <yarnVersion>v1.22.22</yarnVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>yarn-install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                    </execution>
                    <execution>
                        <id>yarn-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>yarn</goal></goals>
                        <configuration>
                            <arguments>${yarn.arguments}</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
